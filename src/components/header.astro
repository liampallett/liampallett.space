---

---

<header>
    <nav>
        <a
            href="/"
            class={Astro.url.pathname.replace(/\/$/, "") === "" ? "active" : ""}
            aria-current={Astro.url.pathname.replace(/\/$/, "") === "" ? "page" : undefined}
            >liampallett.space
        </a>

        <a
            href="/projects"
            class={Astro.url.pathname.replace(/\/$/, "") === "/projects" ? "active" : ""}
            aria-current={Astro.url.pathname.replace(/\/$/, "") === "/projects" ? "page" : undefined}
            >see projects
        </a>

        <a
            href="/blog"
            class={Astro.url.pathname.startsWith("/blog") ? "active" : ""}
            aria-current={Astro.url.pathname.startsWith("/blog") ? "page" : undefined}
            >read blog
        </a>

        <a href="/cv.pdf" target="_blank" rel="noopener noreferrer"> download cv </a>
    </nav>
</header>

<style>
    header::before {
        content: "";
        position: absolute;
        inset: 0;
        opacity: 0.25;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
        background-repeat: repeat;
        background-size: 128px 128px;
        pointer-events: none;
        z-index: -1;
    }

    header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 100;
        box-sizing: border-box;

        display: flex;
        align-items: center;
        padding: 1rem 2rem;

        background-color: color-mix(in srgb, var(--bg) 85%, transparent);

        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);

        border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    }

    nav {
        display: flex;
        gap: 1.5rem;
    }

    a {
        font-size: 1em;
        color: var(--text-muted);
        text-decoration: none;
        transition: color 0.1s ease-in-out;
    }

    a.active {
        color: var(--text);
    }

    a:hover {
        color: var(--text);
    }

    @media (max-width: 768px) {
        header {
            position: sticky;
            top: 0;
            padding: 1rem;
            mask-image: none;
            -webkit-mask-image: none;
        }

        nav {
            flex-wrap: wrap;
            gap: 0.75rem 1rem;
        }
    }
</style>

<style is:global>
    :root {
        --header-height: 3.5rem;
    }
</style>
