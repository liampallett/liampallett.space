---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";

interface Props {
    title: string;
    atUri?: string;
    ogImage?: string;
}

const { title, atUri, ogImage } = Astro.props;
const publicationUri = "at://did:plc:tgb4klpomminc5lv3clzb6wm/site.standard.publication/3mn5k67ewiz25";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta
            property="og:image"
            content={ogImage
                ? `https://liampallett.space${ogImage}`
                : `https://liampallett.space/blog-images/default.jpg`}
        />

        <link rel="icon" type="image/png" href="/star-32.png" />
        <link rel="apple-touch-icon" href="/star-180.png" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
            rel="stylesheet"
        />
        <script defer src="https://kit.fontawesome.com/a92da80a5c.js" crossorigin="anonymous"></script>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />

        <link rel="alternate" type="application/rss+xml" title="Liam Pallett" href="/rss.xml" />

        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="description"
            content="Liam Pallett — Software Engineering student at the University of Sheffield."
        />
        <meta property="og:title" content={title} />
        <meta property="og:description" content="Software Engineering student & developer." />
        <meta property="og:type" content="website" />
        <meta name="color-scheme" content="light dark" />
        <link rel="site.standard.publication" href={publicationUri} />

        {atUri && <link rel="site.standard.document" href={atUri} />}

        <title>{title}</title>
    </head>

    <body>
        <Header />
        <div class="content">
            <slot />
        </div>
        <Footer />
    </body>

    <style>
        body {
            color: var(--text);
            background-color: var(--bg);
            margin: 0;
            min-height: 100vh;
            padding-top: var(--header-height);
        }

        @media (max-width: 768px) {
            body {
                padding-top: 0;
            }
        }
    </style>

    <style is:global>
        * {
            font-family: "IBM Plex Mono", monospace;
        }

        :root {
            --bg: #f0efed;
            --bg-subtle: #e8e7e4;
            --text: #1a1a1a;
            --text-muted: #6b6b6b;
            --accent: #4a5568;
            --border: #d4d3d0;
            --garden-accent: #7cb342;
        }

        @media (prefers-color-scheme: dark) {
            :root {
                --bg: #161514;
                --bg-subtle: #1f1e1d;
                --text: #e8e6e3;
                --text-muted: #a8a39c;
                --accent: #b0b6c2;
                --border: #31302d;
            }
        }

        html {
            background-color: var(--bg);
        }

        * {
            scrollbar-width: none; /* Firefox */
        }
        *::-webkit-scrollbar {
            display: none; /* Chrome, Safari */
        }

        /* Fix KaTeX sizing to sit naturally within your body paragraphs */
        .katex {
            font-size: 0.9em !important; /* Slightly downsizes the math text */
            letter-spacing: normal;
        }
    </style>
</html>
