---
const {
    title,
    link,
    description,
    date,
    tags = [],
} = Astro.props as {
    title: string;
    link: string;
    description: string;
    date: Date;
    tags: string[];
};
---

<div class="card">
    <h2 class="card-title">
        <a href={link} class="link">{title} </a>
    </h2>
    <p>{description}</p>
    <p>{date.toLocaleDateString()}</p>
    {
        tags.length > 0 && (
            <div class="tags">
                {tags.map((tag: string) => (
                    <span class="tag">{tag}</span>
                ))}
            </div>
        )
    }
</div>

<style>
    .card {
        padding: 1em;
        margin-bottom: 5em;
        text-align: left;
    }

    .card-title {
        font-size: 2.5em;
        margin-top: 0;
        margin-bottom: 0;
    }

    .card p {
        margin: 0;
        font-size: 1.9em;
    }

    .link {
        color: var(--black-kite);
        text-decoration: none;
        transition: color 0.1s ease-in-out;
    }

    .link:hover {
        color: var(--garnet);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5em;
        margin-top: 0.75em;
    }

    .tag {
        background-color: var(--black-kite);
        color: var(--morning-snow);
        font-size: 0.9em;
        padding: 0.2em 0.6em;
        border-radius: 4px;
    }
</style>
