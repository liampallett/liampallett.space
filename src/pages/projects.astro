---
import Layout from "../layouts/layout.astro";
import ProjectCard from "../components/projectCard.astro";

import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const groupedProjects = Object.groupBy(projects, (project) => project.data.date.getFullYear());
---

<Layout title="projects">
    <div class="projects-layout">
        <aside class="sidebar">
            {
                Object.entries(groupedProjects)
                    .sort(([a], [b]) => Number(b) - Number(a))
                    .map(([year, projects]) => (
                        <Fragment>
                            <h3>{year}</h3>

                            {projects?.map((project) => (
                                <a href={`#${project.slug}`} data-project-link={project.slug}>
                                    <span class="month">
                                        {project.data.date
                                            .toLocaleDateString("en-GB", { month: "short" })
                                            .toLowerCase()}
                                    </span>

                                    {project.data.title}
                                </a>
                            ))}
                        </Fragment>
                    ))
            }
        </aside>

        <main class="projects-content">
            {
                projects.map((project) => (
                    <section id={project.slug}>
                        <ProjectCard
                            title={project.data.title}
                            link={project.data.link}
                            description={project.data.description}
                            tags={project.data.tags}
                        />
                    </section>
                ))
            }
        </main>
    </div>
</Layout>

<style>
    .projects-content section {
        scroll-margin-top: calc(var(--header-height) + 1rem);
    }

    .projects-layout {
        display: grid;
        grid-template-columns: 250px minmax(0, 700px);
        gap: 5rem;

        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 1.5rem 0;

        align-items: start;
    }

    .sidebar {
        position: sticky;
        top: 6rem;

        padding-right: 2rem;
        border-right: 1px dashed var(--border);

        display: flex;
        flex-direction: column;
    }

    .sidebar h3 {
        margin: 1.5rem 0 0.5rem;
        font-size: 1rem;
        font-weight: normal;
        color: var(--text);
    }

    .sidebar h3:first-child {
        margin-top: 0;
    }

    .sidebar a {
        display: flex;
        gap: 0.5rem;
        align-items: baseline;

        color: var(--text-muted);
        text-decoration: none;
        margin-bottom: 0.35rem;
        font-size: 0.95rem;

        transition:
            color 0.15s ease,
            transform 0.15s ease;
    }

    .sidebar .month {
        flex-shrink: 0;
        opacity: 0.6;
        width: 2.5rem;
    }

    .sidebar a:hover {
        color: var(--text);
    }

    .sidebar a {
        border-left: 2px solid transparent;
        padding-left: 0.5rem;
    }

    .sidebar a.active {
        color: var(--text);
        border-left-color: var(--text);
    }

    @media (max-width: 768px) {
        .projects-layout {
            grid-template-columns: 1fr;
        }

        .sidebar {
            display: none;
        }
    }
</style>

<script>
    const offset = parseInt(getComputedStyle(document.documentElement).getPropertyValue("--header-height")) + 24;

    document.addEventListener("DOMContentLoaded", () => {
        const sections = [...document.querySelectorAll(".projects-content section")];
        const links = [...document.querySelectorAll("[data-project-link]")];

        if (!sections.length || !links.length) return;

        links.forEach((link) => {
            link.addEventListener("click", () => {
                setActiveLink(link.dataset.projectLink);
            });
        });

        const setActiveLink = (id) => {
            links.forEach((link) => {
                link.classList.toggle("active", link.dataset.projectLink === id);
            });
        };

        const updateActiveLink = () => {
            let currentSection = sections[0];

            for (const section of sections) {
                const rect = section.getBoundingClientRect();

                if (rect.top <= offset) {
                    currentSection = section;
                } else {
                    break;
                }
            }

            setActiveLink(currentSection.id);
        };

        window.addEventListener("scroll", updateActiveLink, {
            passive: true,
        });

        updateActiveLink();
    });
</script>
