<footer>
    <div class="site-map">
        <span>explore:</span>
        <a href="/now">[now]</a>
        <a href="/uses">[uses]</a>
        <a href="/garden">[garden]</a>
        <a href="/colophon">[colophon]</a>
        <a href="/projects">[projects]</a>
        <a href="/blog">[blog]</a>
        <a href="/sitemap">[sitemap]</a>
    </div>

    <div class="socials">
        <span>elsewhere:</span>
        <a href="https://bsky.app/profile/liampallett.space" target="_blank" rel="noopener noreferrer">[bsky]</a>
        <a href="https://tangled.org/@liampallett.space" target="_blank" rel="noopener noreferrer">[tangled]</a>
        <a href="https://www.linkedin.com/in/liam-pallett/" target="_blank" rel="noopener noreferrer">[linkedin]</a>
        <a href="https://www.reddit.com/user/liam_pallett/" target="_blank" rel="noopener noreferrer">[reddit]</a>
        <a href="/rss.xml" target="_blank" rel="noopener noreferrer">[rss]</a>
    </div>

    <div class="footer-meta">
        <div class="footer-left">
            <a href="mailto:liam.pallett06@gmail.com" class="email">liam.pallett06@gmail.com</a>
            <span>·</span>
            <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">made with astro</a>
        </div>

        <div class="footer-center">© Liam Pallett 2026</div>

        <div class="footer-right">
            <span>theme:</span>
            <button id="theme-toggle">[dark]</button>
        </div>
    </div>
</footer>

<style>
    footer {
        display: flex;
        flex-direction: column;
        gap: 1em;
        padding: 2em;
        color: var(--text-muted);
        font-size: 0.9em;
    }

    .site-map {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;

        padding-bottom: 1rem;
        border-bottom: 1px dashed var(--border);
    }

    .socials {
        display: flex;
        flex-wrap: wrap;
        gap: 1em;
    }

    a {
        color: var(--text-muted);
        text-decoration: none;
        transition: color 0.1s ease-in-out;
    }

    a:hover {
        color: var(--text);
    }

    .footer-meta {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;

        margin-top: 0.5rem;
    }

    .footer-left {
        justify-self: start;

        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .footer-center {
        justify-self: center;
    }

    .footer-right {
        justify-self: end;

        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    #theme-toggle {
        all: unset;
        cursor: pointer;
        color: var(--text-muted);
        font: inherit;
    }

    #theme-toggle:hover {
        color: var(--text);
    }

    @media (max-width: 768px) {
        .footer-meta {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 0.75rem;
        }

        .footer-left,
        .footer-right,
        .footer-center {
            justify-self: unset;
        }
    }
</style>

<script is:inline>
    const emailText = document.querySelector(".email");

    if (emailText) {
        emailText.addEventListener("click", (e) => {
            e.preventDefault();

            navigator.clipboard.writeText("liam.pallett06@gmail.com").catch(() => {});

            emailText.textContent = "copied!";

            setTimeout(() => {
                emailText.textContent = "liam.pallett06@gmail.com";
            }, 5000);
        });
    }

    const button = document.getElementById("theme-toggle");

    if (button) {
        function updateLabel() {
            const theme = document.documentElement.dataset.theme;
            button.textContent = theme === "dark" ? "[light]" : "[dark]";
        }

        button.addEventListener("click", () => {
            const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";

            document.documentElement.dataset.theme = next;
            localStorage.setItem("theme", next);

            updateLabel();
        });

        updateLabel();
    }
</script>
