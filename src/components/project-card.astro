---
const { title, link, description, tags = [] } = Astro.props;
---

<div class="card">
    <div class="top-bar">
        <h2 class="card-title">{title}</h2>
        <a href={link} target="_blank" rel="noopener noreferrer" class="tangled-link">View on Tangled</a>
    </div>
    <p>{description}</p>
    {
        tags.length > 0 && (
            <div class="tags">
                {tags.map((tag: string) => (
                    <span class="tag">{tag}</span>
                ))}
            </div>
        )
    }
</div>

<style>
    .card {
        padding: 1em;
        margin-bottom: 5em;
        text-align: left;
    }

    .top-bar {
        display: flex;
        align-items: flex-start;
    }

    .top-bar .card-title {
        font-size: 2.5em;
        margin-top: 0;
        margin-bottom: 0;
    }

    .top-bar a {
        font-size: 2.5em;
        margin-left: auto;
    }

    .card p {
        margin: 0;
        font-size: 1.9em;
    }

    .tangled-link {
        color: var(--black-kite);
        text-decoration: none;
        transition: color 0.1s ease-in-out;
    }

    .tangled-link:hover {
        color: var(--garnet);
        text-decoration: underline;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5em;
        margin-top: 0.75em;
    }

    .tag {
        background-color: var(--black-kite);
        color: var(--morning-snow);
        font-size: 0.9em;
        padding: 0.2em 0.6em;
        border-radius: 4px;
    }

    @media screen and (max-width: 800px) {
        .top-bar {
            flex-direction: column;
        }

        .top-bar a {
            margin-left: 0;
            margin-top: 0.5em;
        }

        .tags {
            justify-content: center;
        }
    }
</style>
