---
import Layout from "../layouts/layout.astro";
import Vh from "../components/vh.astro";
---

<Layout title="404 - Page not found">
    <Vh>
        <h1>Whoops! This is embarrassing.</h1>
        <h2>You probably aren't supposed to see this page.</h2>
        <p>Did you mean to visit the <a href="/">homepage</a>?</p>
    </Vh>
</Layout>

<style>
    h1 {
        font-size: 5em;
        margin: 0;
    }

    h2 {
        font-size: 2.5em;
        margin: 0;
    }

    p {
        font-size: 2.5em;
        margin: 0;
    }

    a {
        color: var(--black-kite);
        transition: color 0.1s ease-in-out;
    }

    a:hover {
        color: var(--garnet);
    }

    @media screen and (max-width: 800px) {
        h1 {
            font-size: 3.5em;
        }

        h2,
        p {
            font-size: 1.5em;
        }
    }
</style>
