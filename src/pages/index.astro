---
import Layout from "../layouts/layout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");

const currentProject =
    projects.find((project) => project.data.current) ??
    projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];

import ActivityFeed from "../components/activityFeed.tsx";
---

<Layout title="liampallett.space">
    <div class="landing-grid">
        <main>
            <section>
                <p class="section-label">// ABOUT</p>

                <h1 class="name">Building software for space.</h1>

                <div class="meta">
                    <span>based in sheffield, uk</span>
                    <span>software engineering @ UoSheffield</span>
                    <span>developing aerospace software</span>
                </div>

                <p class="blurb">
                    Hi, I'm Liam Pallett, a software engineering student. I build simulation software for aerospace
                    applications and occasionally write apps for obsolete technologies.
                </p>

                <p class="blurb">
                    My current work focuses on flight simulation and my TUI IRC client. See what else I'm up to
                    <a class="link" href="/now">now</a>.
                </p>
            </section>

            <section class="project-panel">
                <p class="section-label">// CURRENT FOCUS</p>

                <a href={currentProject.data.link} class="link">
                    <h2>{currentProject.data.title}</h2>
                </a>

                <p>{currentProject.data.description}</p>

                <div class="tags">
                    {currentProject.data.tags.map((tag) => <span>{tag}</span>)}
                </div>

                <a class="link" href="/projects">see all projects →</a>
            </section>
        </main>

        <aside class="activity-panel">
            <p class="section-label">// ACTIVITY</p>

            <ActivityFeed client:load />
        </aside>
    </div>
</Layout>

<style>
    /* Layout */

    .landing-grid {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr);
        gap: 3rem;

        max-width: 1200px;
        margin: 0 auto;
        padding: 3rem 1.5rem;

        align-items: stretch;
    }

    /* Shared typography */

    .section-label {
        margin: 0 0 0.75rem;

        color: var(--text-muted);
        font-size: 0.85rem;
        letter-spacing: 0.1em;
    }

    :global(.link) {
        color: var(--text);
        transition: color 0.15s ease;
    }

    :global(.link:hover) {
        color: var(--text-muted);
    }

    /* About */

    .name {
        margin: 0 0 0.75rem;

        font-size: clamp(2.5rem, 4vw, 3.5rem);
        line-height: 0.95;
    }

    .meta {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;

        margin: 1.25rem 0;

        color: var(--text-muted);
        font-size: 0.9rem;
    }

    .meta span::before {
        content: "• ";
    }

    .blurb {
        margin: 0;

        font-size: 1.15rem;
        line-height: 1.6;
    }

    .blurb + .blurb {
        margin-top: 1rem;
    }

    /* Current focus */

    .project-panel {
        margin-top: 2rem;
        padding-top: 1.25rem;

        border-top: 1px dashed var(--border);
    }

    .project-panel h2 {
        margin: 0;

        font-size: 1.5rem;
        line-height: 1.1;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;

        margin: 1rem 0;
    }

    .tags span {
        color: var(--text-muted);
        font-size: 0.85rem;
    }

    .tags span::before {
        content: "#";
    }

    /* Activity */

    .activity-panel {
        padding-left: 2rem;

        border-left: 1px dashed var(--border);
    }

    .activity-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;

        padding: 1rem 0;

        border-bottom: 1px solid var(--border);
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-type {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.05em;
    }

    .blog {
        color: #fbbf24;
    }

    .bsky {
        color: #60a5fa;
    }

    .tangled {
        color: #a78bfa;
    }

    /* Mobile */

    @media (max-width: 900px) {
        .landing-grid {
            grid-template-columns: 1fr;
            gap: 2rem;

            padding: 2rem 1rem;
        }

        .name {
            font-size: clamp(2rem, 10vw, 3rem);
        }

        .blurb {
            font-size: 1rem;
        }

        .activity-panel {
            padding-top: 2rem;
            padding-left: 0;

            border-top: 1px dashed var(--border);
            border-left: none;
        }
    }

    :global(.activity-item) {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 1rem 0;
        border-bottom: 1px solid var(--border);
    }

    :global(.activity-item:last-child) {
        border-bottom: none;
    }

    :global(.activity-type) {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.05em;
    }

    :global(.activity-meta) {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
    }

    :global(.activity-time) {
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    :global(.activity-image) {
        margin-top: 0.5rem;
        width: 100%;
        height: auto;
        max-height: 600px;
        object-fit: contain;
        display: block;
        border-radius: 4px;
    }

    :global(.activity-status) {
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    :global(.blog) {
        color: #fbbf24;
    }
    :global(.bsky) {
        color: #60a5fa;
    }
    :global(.pr) {
        color: #34d399;
    }
    :global(.repo) {
        color: #a78bfa;
    }
    :global(.commit) {
        color: #a78bfa;
    }
</style>
