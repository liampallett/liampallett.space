---
import Layout from "../../layouts/layout.astro";
import Vh from "../../components/vh.astro";
import { getCollection } from "astro:content";
import { StandardSitePublisher } from "@bryanguffey/astro-standard-site";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await post.render();

let atUri: string | undefined = undefined;

// This will now execute correctly on Netlify!
if (process.env.ATPROTO_APP_PASSWORD) {
    try {
        const publisher = new StandardSitePublisher({
            handle: "liampallett.space",
            appPassword: process.env.ATPROTO_APP_PASSWORD,
        });

        await publisher.login();

        const result = await publisher.publishDocument({
            site: "at://did:plc:tgb4klpomminc5lv3clzb6wm/site.standard.publication/3mn2tyfyflb27",
            title: post.data.title,
            description: post.data.description,
            publishedAt: post.data.date.toISOString(),
            path: `/blog/${post.slug}/`,
            content: {
                $type: "site.standard.content.markdown",
                text: post.body,
                version: "1.0",
            },
            textContent: post.body.replace(/[#*`_\-]/g, ""),
            tags: post.data.tags || [],
        });

        atUri = result.uri;
    } catch (error) {
        console.error("⚠️ ATProto dynamic ingestion failed:", error);
    }
}
---

<Layout title={post.data.title} atUri={atUri} ogImage={post.data.ogImage}>
    <Vh>
        <div class="prose">
            {
                post.data.tags.length > 0 && (
                    <div class="tags">
                        {post.data.tags.map((tag: string) => (
                            <span class="tag">{tag}</span>
                        ))}
                    </div>
                )
            }
            <Content />
        </div>
    </Vh>
</Layout>

<style is:global>
    .prose {
        font-size: 1.9em;
        padding-bottom: 4rem;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5em;
        margin-bottom: 1.5em;
    }

    .tag {
        background-color: var(--black-kite);
        color: var(--morning-snow);
        font-size: 0.5em;
        padding: 0.2em 0.6em;
        border-radius: 4px;
    }

    .prose h1 {
        font-size: 2.5em;
    }

    .prose h2 {
        font-size: 2em;
        font-weight: normal;
    }

    .prose h3 {
        font-size: 1.5em;
        font-weight: normal;
    }

    .prose img {
        max-width: 70%;
        height: auto;
        display: block;
        margin-inline: auto;
        margin-block: 2em;
    }

    @media screen and (max-width: 800px) {
        .prose img {
            max-width: 100%;
        }

        .prose {
            font-size: 1.2em;
            text-align: left;
        }

        .prose h1 {
            font-size: 1.8em;
        }

        .prose h2 {
            font-size: 1.5em;
        }

        .prose h3 {
            font-size: 1.2em;
        }
    }
</style>
