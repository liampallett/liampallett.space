---
import Layout from "../layouts/layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const grouped = Object.groupBy(posts, (post) => `${post.data.date.getFullYear()}`);

const years = Object.keys(grouped);
const showSidebar = years.length > 1;

const sortedYears = Object.entries(grouped).sort(([a], [b]) => Number(b) - Number(a));

const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<Layout title="blog">
    <div class:list={["archive-layout", { compact: !showSidebar }]}>
        {
            showSidebar && (
                <aside class="sidebar">
                    {sortedYears.map(([year]) => (
                        <a href={`#${year}`}>{year}</a>
                    ))}
                </aside>
            )
        }

        <main class="archive-content">
            {
                allTags.length > 0 && (
                    <div class="tag-filters">
                        {allTags.map((tag) => (
                            <button type="button" class="tag-filter" data-tag={tag}>
                                {tag}
                            </button>
                        ))}
                    </div>
                )
            }

            {
                sortedYears.map(([year, yearPosts]) => (
                    <section id={year} data-year-section>
                        <h2>{year}</h2>

                        <ul>
                            {yearPosts?.map((post) => (
                                <li data-tags={post.data.tags.join(",")}>
                                    <span class="date">
                                        {post.data.date
                                            .toLocaleDateString("en-GB", {
                                                day: "numeric",
                                                month: "short",
                                            })
                                            .toLowerCase()}
                                    </span>

                                    <div>
                                        <a href={`/blog/${post.slug}`}>{post.data.title}</a>

                                        <p>{post.data.description}</p>

                                        {post.data.tags.length > 0 && (
                                            <p class="tags">
                                                <span>tags:</span>
                                                {post.data.tags.join(", ")}
                                            </p>
                                        )}
                                    </div>
                                </li>
                            ))}
                        </ul>
                    </section>
                ))
            }

            <p class="no-results" hidden>No posts match the selected tag.</p>
        </main>
    </div>
</Layout>

<style>
    .archive-layout {
        display: grid;
        grid-template-columns: 120px minmax(0, 700px);
        gap: 5rem;

        max-width: 900px;
        min-height: calc(100vh - var(--header-height));
        margin: 0 auto;
        padding: 2rem 1.5rem 0;
        box-sizing: border-box;
    }

    @media (max-width: 768px) {
        .archive-layout {
            padding: 2rem 1rem 0;
            box-sizing: border-box;
        }

        .archive-content li {
            flex-direction: column;
            gap: 0.25rem;
            margin-bottom: 1.5rem;
        }

        .date {
            width: auto;
            font-size: 0.9rem;
        }
    }

    .archive-layout.compact {
        grid-template-columns: minmax(0, 700px);
        max-width: 700px;
    }

    .sidebar {
        position: sticky;
        top: 6rem;

        display: flex;
        flex-direction: column;
        gap: 0.5rem;

        padding-right: 2rem;
        border-right: 1px dashed var(--border);
    }

    .sidebar a {
        text-decoration: none;
        color: var(--text-muted);
    }

    .sidebar a:hover {
        color: var(--text);
    }

    .tag-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 2rem;
    }

    .tag-filter {
        font: inherit;
        font-size: 0.85rem;
        color: var(--text-muted);
        background: none;
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0.25rem 0.75rem;
        cursor: pointer;
        transition:
            color 0.15s ease,
            border-color 0.15s ease;
    }

    .tag-filter:hover {
        color: var(--text);
    }

    .tag-filter.active {
        color: var(--text);
        border-color: var(--text);
    }

    .archive-content .tags {
        margin-top: 0.4rem;
        font-size: 0.9em;
        opacity: 1;
    }

    .no-results {
        opacity: 0.7;
    }

    .archive-content section {
        margin-bottom: 3rem;
    }

    .archive-content h2 {
        margin: 0 0 1.25rem;
    }

    .archive-content ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .archive-content li {
        display: flex;
        gap: 1rem;
        margin-bottom: 0.5rem;
    }

    .archive-content li[hidden],
    [data-year-section][hidden] {
        display: none;
    }

    .date {
        width: 4.5rem;
        flex-shrink: 0;
        opacity: 0.6;
    }

    .archive-content a {
        color: var(--text);
        text-decoration: none;
        font-weight: 600;
    }

    .archive-content a:hover {
        text-decoration: underline;
    }

    .archive-content p {
        margin: 0.15rem 0 0.75rem;
        opacity: 0.7;
        max-width: 60ch;
    }

    @media (max-width: 768px) {
        .archive-layout {
            grid-template-columns: 1fr;
            padding: 2rem 1rem 0;
        }

        .sidebar {
            display: none;
        }

        .archive-content li {
            flex-direction: column;
            gap: 0.25rem;
            margin-bottom: 1.5rem;
        }

        .date {
            width: auto;
            font-size: 0.9rem;
        }
    }
</style>

<script>
    const buttons = [...document.querySelectorAll<HTMLButtonElement>(".tag-filter")];
    const sections = [...document.querySelectorAll<HTMLElement>("[data-year-section]")];
    const noResults = document.querySelector<HTMLElement>(".no-results");

    let activeTag: string | null = null;

    const applyFilter = () => {
        let anyVisible = false;

        for (const section of sections) {
            let sectionHasVisible = false;

            for (const item of section.querySelectorAll<HTMLLIElement>("li")) {
                const tags = (item.dataset.tags ?? "").split(",");
                const visible = !activeTag || tags.includes(activeTag);

                item.hidden = !visible;

                if (visible) {
                    sectionHasVisible = true;
                    anyVisible = true;
                }
            }

            section.hidden = !sectionHasVisible;
        }

        if (noResults) noResults.hidden = anyVisible;
    };

    buttons.forEach((button) => {
        button.addEventListener("click", () => {
            const tag = button.dataset.tag ?? null;

            activeTag = activeTag === tag ? null : tag;

            buttons.forEach((b) => b.classList.toggle("active", b.dataset.tag === activeTag));

            applyFilter();
        });
    });
</script>
