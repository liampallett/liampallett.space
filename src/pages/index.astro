---
import Layout from "../layouts/layout.astro";
import Card from "../components/card.astro";

import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recentPosts = posts.slice(0, 2);

const projects = await getCollection("projects");

const featuredProject =
    projects.find((project) => project.data.featured) ??
    projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---

<Layout title="liampallett.space">
    <div class="hero-content">
        <div class="main-content">
            <h1 class="name">Hi! I'm Liam Pallett.</h1>

            <p class="blurb">
                I'm an aspiring aerospace software engineer studying software engineering at the University of
                Sheffield. Catch me building simulations, writing about space and software, or occasionally disappearing
                down internet rabbit holes. See what I'm up to <a href="/now">now</a>.
            </p>

            <section class="featured-project">
                <h2>Featured Project</h2>
                <p class="section-blurb">Whatever I'm currently devoting my time to.</p>

                {
                    featuredProject && (
                        <Card
                            title={featuredProject.data.title}
                            link={featuredProject.data.link}
                            description={featuredProject.data.description}
                            tags={featuredProject.data.tags}
                        />
                    )
                }

                <a class="link" href="/projects">See all projects</a>
            </section>

            <section class="recent-posts">
                <h2>Recent Posts</h2>

                <p class="section-blurb">
                    Notes on software, space, conferences, astrophotography, and whatever else catches my attention.
                </p>

                {
                    recentPosts.map((post) => (
                        <Card
                            title={post.data.title}
                            link={`/blog/${post.slug}`}
                            date={post.data.date}
                            description={post.data.description}
                            tags={post.data.tags}
                        />
                    ))
                }

                <a class="link" href="/blog">Read more posts</a>
            </section>
        </div>
    </div>
</Layout>

<style>
    .hero-content {
        min-height: calc(100vh - var(--header-height));
        max-width: 900px;
        margin: 0 auto;
        width: 100%;
        padding: 3em 1.5rem;
    }

    .main-content {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    /* typography */
    .name {
        font-size: 2.5em;
        margin: 0;
    }

    .blurb {
        font-size: 1.25em;
        margin: 0;
    }

    .link {
        color: var(--text);
        text-decoration: none;
        font-size: 1.1em;
    }

    .link:hover {
        color: var(--text-muted);
    }

    .main-content h2 {
        margin-bottom: 0;
    }

    .section-blurb {
        margin: 0.25rem 0 1rem;
        color: var(--text-muted);
    }

    @media (max-width: 768px) {
        .card {
            padding: 1rem 0;
        }

        .card h3 {
            line-height: 1.2;
        }

        .card .tags {
            flex-wrap: wrap;
        }
    }
</style>
