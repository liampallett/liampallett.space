<footer>
    <div class="site-map">
        <a href="/now">[now]</a>
        <a href="/uses">[uses]</a>
        <a href="/garden">[garden]</a>
        <a href="/projects">[projects]</a>
        <a href="/blog">[blog]</a>
        <a href="/sitemap">[sitemap]</a>
    </div>

    <div class="socials">
        <a href="https://bsky.app/profile/liampallett.space" target="_blank" rel="noopener noreferrer">[bsky]</a>
        <a href="https://tangled.org/@liampallett.space" target="_blank" rel="noopener noreferrer">[tangled]</a>
        <a href="https://www.linkedin.com/in/liam-pallett/" target="_blank" rel="noopener noreferrer">[linkedin]</a>
        <a href="https://www.reddit.com/user/liam_pallett/" target="_blank" rel="noopener noreferrer">[reddit]</a>
        <a href="/rss.xml" target="_blank" rel="noopener noreferrer">[rss]</a>
    </div>
    <div class="footer-meta">
        <p>© Liam Pallett 2026</p>
        <p>
            <a href="mailto:liam.pallett06@gmail.com" class="email">liam.pallett06@gmail.com</a>
            · made with <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">astro</a>
        </p>
    </div>
</footer>

<style>
    footer {
        display: flex;
        flex-direction: column;
        gap: 1em;
        padding: 2em;
        color: var(--text-muted);
        font-size: 0.9em;
    }

    .site-map {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;

        padding-bottom: 1rem;
        border-bottom: 1px dashed var(--border);
    }
    .socials {
        display: flex;
        flex-wrap: wrap;
        gap: 1em;
    }
    a {
        color: var(--text-muted);
        text-decoration: none;
        transition: color 0.1s ease-in-out;
    }
    a:hover {
        color: var(--text);
    }
    p {
        margin: 0;
    }
    .footer-meta {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.5em;
    }
    @media screen and (max-width: 800px) {
        .footer-meta {
            flex-direction: column;
        }
    }
</style>

<script is:inline>
    const emailText = document.querySelector(".email");
    emailText.addEventListener("click", copyEmail);
    function copyEmail(e) {
        e.preventDefault();
        navigator.clipboard.writeText("liam.pallett06@gmail.com").catch(() => {});
        emailText.textContent = "copied!";
        setTimeout(() => {
            emailText.textContent = "liam.pallett06@gmail.com";
        }, 5000);
    }
</script>
