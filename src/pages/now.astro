---
import Basic from "../layouts/basic.astro";
import MediaGallery from "../components/mediaGallery.astro";

import albumItems from "../data/albums";
import bookItems from "../data/books";
import watchingItems from "../data/watching";
---

<Basic title="now" dateLastUpdated="june 2026">
    <p>This is a snapshot of what I'm doing right now. Updated whenever things change enough to be worth noting.</p>

    <h2>working on</h2>
    <ul>
        <li>revising for exams :/</li>
        <li>helping to establish the uni of sheffield microcontroller hackerspace</li>
    </ul>

    <h2>current interests</h2>
    <ul>
        <li>irc / rss / "obsolete" technologies</li>
        <li>linux and self-hosting</li>
        <li>astrophotography</li>
    </ul>

    <h2>thinking about</h2>
    <ul>
        <li>making the website more personal</li>
    </ul>

    <h2>current media</h2>

    <h3>listening</h3>
    <MediaGallery items={albumItems} variant="square" />

    <h3>reading</h3>
    <MediaGallery items={bookItems} variant="portrait" />

    <h3>watching</h3>
    <MediaGallery items={watchingItems} variant="portrait" />

    <p>
        Inspired by
        <a href="https://nownownow.com/about" target="_blank" rel="noopener noreferrer"> the /now movement </a>.
    </p>
</Basic>
