---
interface Item {
    title: string;
    image: string;
    alt?: string;
}

interface Props {
    items: Item[];
    variant?: "square" | "portrait";
}

const { items, variant = "square" } = Astro.props;
---

<div class={`media-gallery ${variant}`}>
    {
        items.map((item) => (
            <div class="media-entry">
                <div class="media-item">
                    <img src={item.image} alt={item.alt ?? item.title} />
                </div>

                <div class="media-title">{item.title}</div>
            </div>
        ))
    }
</div>

<style>
    .media-gallery {
        width: 100%;
        display: flex;
        position: relative;
        margin: 1.5rem 0;
        margin-left: -6px;
    }

    .media-entry:hover .media-title {
        visibility: visible;
    }

    .media-item {
        perspective: 500px;
        width: 18px;
        transition: width 0.5s;
    }

    .media-item:hover img {
        transform: rotateY(10deg);
    }

    /* Square covers (albums, games) */

    .media-gallery.square {
        height: 230px;
    }

    .media-gallery.square .media-item:hover {
        width: 148px;
    }

    .media-gallery.square img {
        width: 180px;
        height: 180px;
    }

    .media-gallery.square .media-item:hover img {
        width: 188px;
        height: 188px;
        margin-top: -2px;
    }

    /* Portrait covers (films, TV, books) */

    .media-gallery.portrait {
        height: 280px;
    }

    .media-gallery.portrait .media-item:hover {
        width: 120px;
    }

    .media-gallery.portrait img {
        width: 140px;
        height: 210px;
    }

    .media-gallery.portrait .media-item:hover img {
        width: 148px;
        height: 222px;
        margin-top: -4px;
    }

    /* Shared image styling */

    .media-gallery img {
        object-fit: cover;

        border-radius: 4px;
        border: 2px solid rgba(0, 0, 0, 0.1);

        transform: rotateY(25deg);
        transform-style: preserve-3d;

        transition:
            transform 0.5s,
            width 0.5s,
            height 0.5s,
            margin-top 0.5s;
    }

    .media-title {
        visibility: hidden;

        position: absolute;
        bottom: 0;

        width: 100%;

        text-align: center;

        color: var(--text);
        font: inherit;
    }
</style>
