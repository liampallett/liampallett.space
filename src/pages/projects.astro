---
import Layout from "../layouts/layout.astro";
import Vh from "../components/vh.astro";
import ProjectCard from "../components/project-card.astro";
---

<Layout title="Projects">
    <Vh>
        <ProjectCard
            title="glirc (2026)"
            link="https://tangled.org/liampallett.space/glirc"
            description="glirc is a CLI-based IRC client written in Go."
            tags={["Golang", "IRC", "Socket Programming"]}
        />

        <ProjectCard
            title="Investigating Star Tracking Algorithms (2026)"
            link="https://tangled.org/liampallett.space/investigating-star-tracking-algorithms"
            description="Machine learning algorithm to identify real and fake stars within a satellite sensor view based on published research."
            tags={["Python", "Machine Learning", "Aerospace Applications", "Satellite Systems"]}
        />

        <ProjectCard
            title="ISS Pass Bot (2026)"
            link="https://tangled.org/liampallett.space/iss-bluesky-bot"
            description="Bluesky bot that calculates ISS passes over Sheffield, UK."
            tags={["Python", "Celestrak API", "AT Proto", "Orbit Propagation"]}
        />

        <ProjectCard
            title="Orbit Simulation (2026)"
            link="https://tangled.org/liampallett.space/orbit-simulation"
            description="Simple 2D orbit simulator written in Python."
            tags={["Python", "Orbital Mechanics", "Simulation"]}
        />

        <ProjectCard
            title="Flight Dynamics (2026)"
            link="https://tangled.org/liampallett.space/flight-dynamics"
            description="Flight dynamics simulator written in Python. Simulate complex multi-stage rockets with different propellant and engine configuration."
            tags={["Python", "Isentropic Flow", "Simulation", "Rocketry"]}
        />

        <ProjectCard
            title="Satellite Visualiser (2026)"
            link="https://tangled.org/liampallett.space/satellite-visualiser"
            description="Visualise the live orbits of Earth's satellites and space stations."
            tags={["Python", "Celestrak API", "Keplerian Motion"]}
        />

        <ProjectCard
            title="Physics Engine (2026)"
            link="https://tangled.org/liampallett.space/physics-engine"
            description="Custom physics engine with Vector2D implementation."
            tags={["C++", "Physics Engine", "Simulation"]}
        />

        <ProjectCard
            title="Open-TTP (2026)"
            link="https://tangled.org/liampallett.space/open-ttp"
            description="A simple C++ program for simulating and decoding 64-byte packed binary telemetry data with integrity validation."
            tags={["C++", "Telemetry", "Protocol Design", "Binary Frames"]}
        />

        <ProjectCard
            title="Personal/Portfolio Website (2025)"
            link="https://tangled.org/liampallett.space/liampallett.space"
            description="Personal portfolio page built in Astro and deployed via custom CI/CD pipeline and Netlify webhooks."
            tags={["Astro", "TypeScript", "CSS"]}
        />
    </Vh>
</Layout>
